# 默认按文本处理，仓库内统一使用 LF，检出时不做转换
* text=auto eol=lf

# 明确指定文本类型，避免混用 CRLF 造成整文件级别的无意义 diff
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf

# 二进制文件不做行尾转换，也不做 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.vsdx  binary
*.vsx   binary
